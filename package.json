{
  "name": "facebook-sheet-autoposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-row-at-a-time Google Sheets to Facebook Group autoposter for Windows.",
  "scripts": {
    "start": "node src/run.js",
    "start:all": "node src/run.js --all",
    "start:all:popup": "node src/run.js --all --popup",
    "dry-run": "node src/run.js --dry-run",
    "dry-run:all": "node src/run.js --dry-run --all",
    "login:google": "node src/login-google.js",
    "login:facebook": "node src/login-facebook.js",
    "check:facebook": "node src/check-facebook.js",
    "resolve:links": "node src/resolve-links.js",
    "split-groups": "node src/split-groups.js",
    "classify-groups": "node src/classify-groups.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "googleapis": "176.0.0",
    "playwright": "1.62.1"
  }
}
